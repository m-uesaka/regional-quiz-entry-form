# The origin of the backend Worker (`apps/backend`). `src/hooks.server.ts`
# forwards `/api/*` there during SSR, and `vite.config.ts` proxies the
# browser's `/api/*` requests to the same place.
#
# `bun run dev:backend` (i.e. `wrangler dev`) serves it here by default.
#
# Pointing this at an HTTPS dev server (`wrangler dev --local-protocol https`)
# makes every page 500: that certificate is self-signed, and the runtime
# `fetch` `src/hooks.server.ts` forwards SSR calls with has no per-request way
# to accept it. Run `bun run dev:frontend` with
# `NODE_TLS_REJECT_UNAUTHORIZED=0` in front if you need that, the way
# `apps/e2e/playwright.config.ts` does for the test run.
BACKEND_URL=http://127.0.0.1:8787

# The HS256 secret the backend signs session JWTs with. `src/hooks.server.ts`
# verifies `staff_session` / `participant_session` with it to fill
# `event.locals`, so it must be the **same value** the backend Worker uses
# (`wrangler secret put SESSION_SECRET`, or `apps/backend/.dev.vars` locally).
# With this unset, every request looks logged out and `/staff/*` bounces back
# to the login screen.
SESSION_SECRET=dev-session-secret

# Cloudflare Turnstile のサイトキー。エントリーフォームとパスワード再設定要求
# フォームのウィジェット(`src/lib/components/Turnstile.svelte`)が読む。
#
# 既定値は Cloudflare が公開しているテスト用サイトキーで、操作なしで必ず成功する
# ウィジェットを描画する。バックエンド側のテスト用シークレット
# (`apps/backend/wrangler.toml` の `TURNSTILE_SECRET_KEY`)と対になっており、
# ローカル開発ではこの組み合わせでフォームが通る。
#
# 未設定にするとウィジェットは描画されず、トークンも送られないため、バックエンド
# (トークンを必ず検証し、失敗時は落とす)が 400 で拒否する。本番・staging では
# Pages の環境変数に本物のサイトキーを設定する(`docs/supabase-deployment.md` 6.3)。
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
